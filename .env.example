# ---- Database (Prisma + SQLite) ----
DATABASE_URL="file:./db/custom.db"

# ---- AI gateway (OpenAI-compatible) ----
# Vision / chat:  POST {AI_GATEWAY_BASE_URL}/chat/completions
# Speech output:  POST {AI_GATEWAY_BASE_URL}/audio/speech
# Speech input:   POST {AI_GATEWAY_BASE_URL}/audio/transcriptions
AI_GATEWAY_BASE_URL="https://your-gateway.example.com/v1"
AI_GATEWAY_API_KEY="replace-with-your-key"

# Vision model used for scene understanding
AI_MODEL="glm-4.6v"

# Cloud TTS voice used as the Hindi last-resort fallback
CLOUD_TTS_VOICE="default"
